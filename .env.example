# Neon PostgreSQL connection string. Use the pooled connection string in production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Auth.js / workforce OIDC. Use a cryptographically random secret of at least 32 bytes.
# Local-only UI development bypass; the app ignores this unless NODE_ENV=development.
DEV_AUTH_BYPASS=false
AUTH_SECRET=replace-with-a-random-secret
AUTH_OIDC_ISSUER=https://identity.example.com
AUTH_OIDC_CLIENT_ID=replace-with-client-id
AUTH_OIDC_CLIENT_SECRET=replace-with-client-secret
AUTH_OIDC_PROVIDER_NAME=Organization sign-in
ADMIN_EMAILS=admin@example.com
CONSULTANT_EMAILS=consultant@example.com

# Independent 32-byte base64 keys. Never reuse AUTH_SECRET or each other.
INQUIRY_ENCRYPTION_KEY=replace-with-32-byte-base64-key
SITE_ASSESSMENT_ENCRYPTION_KEY=replace-with-a-different-32-byte-base64-key
REFERENCE_KEY_HMAC_SECRET=replace-with-a-random-secret
RATE_LIMIT_HMAC_KEY=replace-with-a-different-random-secret
CRON_SECRET=replace-with-a-random-secret
